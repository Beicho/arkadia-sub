# ===== 必填 =====
# 会话签名密钥:openssl rand -hex 32
SESSION_SECRET=
# PostgreSQL 容器密码(compose 用)
POSTGRES_PASSWORD=
# 站点对外地址(拼订阅链接 / OAuth 回调 / 支付回调)
APP_URL=https://subscription.example.com

# ===== LinuxDo Connect OAuth(connect.linux.do 创建应用) =====
# 回调地址填:{APP_URL}/api/auth/callback
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# LinuxDo 管理员用户名，多个值用逗号分隔
ADMIN_USERNAMES=

# ===== LDC 支付(credit.linux.do 控制台创建 API Key) =====
LDC_PID=
LDC_KEY=
# 一般不用改
LDC_EPAY_BASE=https://credit.linux.do/epay

# 上游订阅地址（可能包含访问令牌，禁止提交真实值）
UPSTREAM_SUBSCRIPTION_URL=

# ===== 可选 =====
# 待支付订单有效期(分钟),超时自动关闭并回补库存
LDC_ORDER_EXPIRE_MINUTES=5
# 开发用假登录(仅非 production 生效):1 开启
DEV_FAKE_LOGIN=0
# 数据库直连(compose 之外跑的时候)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/arkadia
